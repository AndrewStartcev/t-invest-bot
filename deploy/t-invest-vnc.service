[Unit]
Description=T-Invest loopback-only browser desktop
Requires=t-invest-display.service
After=t-invest-display.service

[Service]
User=t-invest-bot
Group=t-invest-bot
ExecStart=/usr/bin/x11vnc -display :99 -localhost -rfbport 5901 -forever -shared -nopw -noxdamage
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
