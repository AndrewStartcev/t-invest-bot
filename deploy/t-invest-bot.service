[Unit]
Description=T-Invest Bot
Wants=network-online.target
Requires=t-invest-display.service
After=network-online.target t-invest-display.service

[Service]
Type=simple
User=t-invest-bot
Group=t-invest-bot
WorkingDirectory=/opt/t-invest-bot
EnvironmentFile=/etc/t-invest-bot/server.env
RuntimeDirectory=t-invest-bot
RuntimeDirectoryMode=0700
Environment=TMPDIR=/run/t-invest-bot
ExecStart=/opt/t-invest-bot/.venv/bin/python -u /opt/t-invest-bot/server_entry.py --port 8765
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/t-invest-bot /run/t-invest-bot -/var/lib/t-invest-auth

[Install]
WantedBy=multi-user.target
