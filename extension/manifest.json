{
  "manifest_version": 3,
  "name": "T-Invest Pulse Browser Source",
  "version": "0.3.0",
  "description": "Авторизация и чтение инструментов и сделок Пульса через браузер клиента, без банковского входа на сервере",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.tbank.ru/*",
    "https://*.tbank-online.com/*",
    "https://invest.argokov.ru/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tbank.ru/invest/*",
        "https://*.tbank-online.com/invest/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Пульс · Контроль авторизации",
    "default_popup": "popup.html"
  }
}
