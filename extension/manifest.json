{
  "manifest_version": 3,
  "name": "T-Invest Pulse Browser Source",
  "version": "0.7.2",
  "description": "Мониторинг сделок и чтение видимого портфеля Пульса через Яндекс Браузер / Brave без серверного входа",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://tbank.ru/*",
    "https://www.tbank.ru/*",
    "https://tbank-online.com/*",
    "https://www.tbank-online.com/*",
    "https://invest.argokov.ru/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tbank.ru/invest/*",
        "https://www.tbank.ru/invest/*",
        "https://tbank-online.com/invest/*",
        "https://www.tbank-online.com/invest/*"
      ],
      "js": [
        "content.js",
        "portfolio.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "T-Invest · сделки и портфель",
    "default_popup": "popup.html"
  }
}
